# Paper Radar supports DeepSeek, OpenAI, and other Responses-API-compatible providers.
# Never commit a real API key. Configure secrets in Railway Variables.

# Recommended default: DeepSeek
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# Generic provider with an OpenAI Responses API-compatible endpoint
# LLM_PROVIDER=generic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# Reserved for a future embedding-based semantic layer.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
