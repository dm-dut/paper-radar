# Paper Radar supports school/lab OpenAI-compatible gateways, DeepSeek official API, and OpenAI.
# Never commit a real API key. Configure secrets in Railway Variables.

# Recommended for the DUT lab gateway currently used by this project
LLM_PROVIDER=generic
LLM_BASE_URL=http://aigw.dlut.edu.cn/v1
LLM_MODEL=DeepSeek-V4-Flash-0731-W8A8
LLM_API_MODE=chat_completions
LLM_JSON_MODE=auto
# If the gateway requires a bearer token, set it in Railway Variables.
LLM_API_KEY=

# DeepSeek official API alternative
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_MODE=chat_completions

# OpenAI alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_API_MODE=responses
